# CareConnect Server Environment
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# MongoDB
MONGO_URI=mongodb://localhost:27017/careconnect

# JWT
JWT_SECRET=careconnect-super-secret-change-me-in-production
JWT_EXPIRES_IN=7d

# Google Gemini AI (optional - falls back to heuristic engine when empty)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# File uploads
MAX_FILE_SIZE=5242880